{
  "name": "proof",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:api": "npm run dev --workspace=@proof/api",
    "start": "npx --yes serve@14 -s build/client -l 3000",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "db:generate": "npm run db:generate --workspace=@proof/api",
    "db:migrate": "npm run db:migrate --workspace=@proof/api",
    "db:push": "npm run db:push --workspace=@proof/api",
    "db:studio": "npm run db:studio --workspace=@proof/api"
  },
  "dependencies": {
    "@react-router/node": "^7.5.3",
    "@react-router/serve": "^7.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "14.0.0",
    "gsap": "3.15.0",
    "isbot": "^5.1.27",
    "lucide-react": "1.54.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.3",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@react-router/dev": "^7.5.3",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "9.36.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "15.15.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.44.1",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.7"
  }
}
